{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leon-made-this.local/schemas/agent-visual-review.schema.json",
  "title": "Prehistoric animal agent visual review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "animalId",
    "reviewer",
    "reviewerTaskId",
    "reviewedAt",
    "modelContractSha256",
    "modelSha256",
    "reviewContractPath",
    "reviewContractSha256",
    "browserCaptureSha256",
    "browserCaptureValidationSha256",
    "overallStatus",
    "checks",
    "contractProofs",
    "motionSamples",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "animalId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "reviewer": { "type": "string" },
    "reviewerTaskId": { "type": "string" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "modelContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewContractPath": { "type": "string", "minLength": 1 },
    "reviewContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "browserCaptureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "browserCaptureValidationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "overallStatus": { "enum": ["pending", "pass", "fail"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "finding", "evidencePaths"],
        "properties": {
          "id": {
            "enum": [
              "anatomy-and-silhouette",
              "appendage-count-and-symmetry",
              "face-teeth-tongue-integrity",
              "full-loop-motion",
              "initial-camera-semantics",
              "responsive-framing",
              "ground-contact",
              "material-and-lighting",
              "child-comfort"
            ]
          },
          "status": { "enum": ["pending", "pass", "fail", "not-applicable"] },
          "finding": { "type": "string" },
          "evidencePaths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "contractProofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectType",
          "subjectId",
          "requiredAuthority",
          "status",
          "verifiedBy",
          "finding",
          "evidence"
        ],
        "properties": {
          "subjectType": { "enum": ["target-issue", "invariant", "state-sequence"] },
          "subjectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "requiredAuthority": { "enum": ["machine-pass", "agent-visual-pass", "owner-approval"] },
          "status": { "enum": ["pending", "pass", "fail"] },
          "verifiedBy": { "type": "string" },
          "finding": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirementId", "evidencePaths"],
              "properties": {
                "requirementId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "evidencePaths": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "motionSamples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeSeconds", "evidencePath"],
        "properties": {
          "timeSeconds": { "enum": [0, 2, 4, 6, 8] },
          "evidencePath": { "type": "string" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
