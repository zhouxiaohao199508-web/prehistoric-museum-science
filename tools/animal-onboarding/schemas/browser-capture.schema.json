{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leon-made-this.local/schemas/browser-capture.schema.json",
  "title": "Headed browser capture evidence",
  "description": "Collector-attested portable metadata from an already-open headed Browser or Chrome session. The onboarding tool validates internal consistency, state effects and referenced screenshots without claiming cryptographic control-surface provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "planId",
    "planSha256",
    "animalId",
    "capturedAt",
    "browser",
    "finalGlbSha256",
    "page",
    "stateSequence",
    "captures",
    "globalBaseline"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "headed-browser-capture-evidence" },
    "planId": { "$ref": "#/$defs/nonEmptyString" },
    "planSha256": { "$ref": "#/$defs/sha256" },
    "animalId": { "$ref": "#/$defs/safeId" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlSurface",
        "headed",
        "collector",
        "collectorTaskId",
        "attestation"
      ],
      "properties": {
        "controlSurface": { "enum": ["Browser", "Chrome"] },
        "headed": { "const": true },
        "collector": { "type": "string", "minLength": 1 },
        "collectorTaskId": { "type": "string", "minLength": 1 },
        "attestation": {
          "const": "I collected these artifacts from the declared already-open headed Browser or Chrome control surface and recorded the observed page state without synthetic replacement."
        },
        "userAgent": { "type": "string" }
      }
    },
    "finalGlbSha256": { "$ref": "#/$defs/sha256" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "actualLoadedGlbSha256"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "actualLoadedGlbSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stateSequence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stateEvidence" }
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capture" }
    },
    "globalBaseline": { "$ref": "#/$defs/globalBaseline" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finiteNumber": { "type": "number" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "deviceScaleFactor"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "deviceScaleFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        }
      }
    },
    "cameraAngle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "yawDegrees",
        "pitchDegrees",
        "distance",
        "target"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "yawDegrees": { "$ref": "#/$defs/finiteNumber" },
        "pitchDegrees": { "$ref": "#/$defs/finiteNumber" },
        "distance": { "type": "number", "exclusiveMinimum": 0 },
        "target": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/finiteNumber" }
        }
      }
    },
    "stateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sequenceIndex"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["initial", "interaction"] },
        "sequenceIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "stateAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": { "command": { "const": "reset-view" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "yawDeltaDegrees", "pitchDeltaDegrees"],
          "properties": {
            "command": { "const": "orbit" },
            "yawDeltaDegrees": { "$ref": "#/$defs/finiteNumber" },
            "pitchDeltaDegrees": { "$ref": "#/$defs/finiteNumber" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "delta"],
          "properties": {
            "command": { "const": "zoom" },
            "delta": { "$ref": "#/$defs/finiteNumber" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "xPixels", "yPixels"],
          "properties": {
            "command": { "const": "pan" },
            "xPixels": { "$ref": "#/$defs/finiteNumber" },
            "yPixels": { "$ref": "#/$defs/finiteNumber" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "name"],
          "properties": {
            "command": { "const": "custom" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "payload": { "type": "object" }
          }
        }
      ]
    },
    "stateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sequenceIndex", "actionsApplied"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["initial", "interaction"] },
        "sequenceIndex": { "type": "integer", "minimum": 0 },
        "actionsApplied": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateAction" }
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clipName",
        "requestedTimeSeconds",
        "actualTimeSeconds",
        "paused"
      ],
      "properties": {
        "clipName": { "$ref": "#/$defs/nonEmptyString" },
        "requestedTimeSeconds": { "type": "number", "minimum": 0 },
        "actualTimeSeconds": { "type": "number", "minimum": 0 },
        "paused": { "type": "boolean" }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "mediaType",
        "bytes",
        "sha256",
        "pixelWidth",
        "pixelHeight"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.png$"
        },
        "mediaType": { "const": "image/png" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pixelWidth": { "type": "integer", "minimum": 1 },
        "pixelHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "actualLoadedGlbSha256",
        "viewport",
        "cameraAngle",
        "state",
        "animation",
        "screenshot"
      ],
      "properties": {
        "requestId": { "$ref": "#/$defs/nonEmptyString" },
        "actualLoadedGlbSha256": { "$ref": "#/$defs/sha256" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "cameraAngle": { "$ref": "#/$defs/cameraAngle" },
        "state": { "$ref": "#/$defs/stateReference" },
        "animation": { "$ref": "#/$defs/animation" },
        "screenshot": { "$ref": "#/$defs/screenshot" }
      }
    },
    "globalBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reportSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "reportSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
