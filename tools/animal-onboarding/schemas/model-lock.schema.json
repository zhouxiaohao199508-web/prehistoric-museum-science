{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leon-made-this.local/schemas/model-lock.schema.json",
  "title": "Prehistoric animal model lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "animalId",
    "decision",
    "acceptedBy",
    "acceptedOn",
    "modelContractSha256",
    "modelSha256",
    "sourceModelPath",
    "sourceModelSha256",
    "baselineAssetSha256",
    "reviewContractPath",
    "reviewContractSha256",
    "stageLockId",
    "stageLockPath",
    "stageLockSha256",
    "riskRoutePath",
    "riskRouteSha256",
    "riskEvidenceManifestPath",
    "riskEvidenceManifestSha256",
    "browserCapturePlanPath",
    "browserCapturePlanSha256",
    "browserCapturePath",
    "browserCaptureSha256",
    "browserCaptureValidationPath",
    "browserCaptureValidationSha256",
    "agentReviewPath",
    "agentReviewSha256",
    "reviewEvidenceBundleSha256",
    "modelQaPath",
    "modelQaSha256",
    "modelQaDecisionSha256",
    "normalizationLogSha256",
    "normalizedBlendSha256",
    "landmarksSha256",
    "glbValidatorSha256",
    "ownerContractProofs"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "animalId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "decision": { "const": "accepted-for-finishing" },
    "acceptedBy": { "type": "string", "minLength": 1 },
    "acceptedOn": { "type": "string", "format": "date" },
    "modelContractSha256": { "$ref": "#/$defs/sha256" },
    "modelSha256": { "$ref": "#/$defs/sha256" },
    "sourceModelPath": { "type": "string", "pattern": "^/" },
    "sourceModelSha256": { "$ref": "#/$defs/sha256" },
    "baselineAssetSha256": { "$ref": "#/$defs/sha256" },
    "reviewContractPath": { "type": "string", "minLength": 1 },
    "reviewContractSha256": { "$ref": "#/$defs/sha256" },
    "stageLockId": { "type": "string", "minLength": 1 },
    "stageLockPath": { "type": "string", "minLength": 1 },
    "stageLockSha256": { "$ref": "#/$defs/sha256" },
    "riskRoutePath": { "type": "string", "minLength": 1 },
    "riskRouteSha256": { "$ref": "#/$defs/sha256" },
    "riskEvidenceManifestPath": { "type": "string", "pattern": "^/" },
    "riskEvidenceManifestSha256": { "$ref": "#/$defs/sha256" },
    "browserCapturePlanPath": { "type": "string", "minLength": 1 },
    "browserCapturePlanSha256": { "$ref": "#/$defs/sha256" },
    "browserCapturePath": { "type": "string", "minLength": 1 },
    "browserCaptureSha256": { "$ref": "#/$defs/sha256" },
    "browserCaptureValidationPath": { "type": "string", "minLength": 1 },
    "browserCaptureValidationSha256": { "$ref": "#/$defs/sha256" },
    "agentReviewPath": { "type": "string", "minLength": 1 },
    "agentReviewSha256": { "$ref": "#/$defs/sha256" },
    "reviewEvidenceBundleSha256": { "$ref": "#/$defs/sha256" },
    "modelQaPath": { "type": "string", "pattern": "^/" },
    "modelQaSha256": { "$ref": "#/$defs/sha256" },
    "modelQaDecisionSha256": { "$ref": "#/$defs/sha256" },
    "normalizationLogSha256": { "$ref": "#/$defs/sha256" },
    "normalizedBlendSha256": { "$ref": "#/$defs/sha256" },
    "landmarksSha256": { "$ref": "#/$defs/sha256" },
    "glbValidatorSha256": { "$ref": "#/$defs/sha256" },
    "ownerContractProofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectType",
          "subjectId",
          "verifiedBy",
          "verifiedOn",
          "evidenceSha256"
        ],
        "properties": {
          "subjectType": { "enum": ["target-issue", "invariant", "state-sequence"] },
          "subjectId": { "type": "string", "minLength": 1 },
          "verifiedBy": { "type": "string", "minLength": 1 },
          "verifiedOn": { "type": "string", "format": "date" },
          "evidenceSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
