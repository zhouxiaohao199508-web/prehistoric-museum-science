{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leon-made-this.local/schemas/risk-evidence-manifest.schema.json",
  "title": "Animal risk evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "animalId",
    "inspectionPath",
    "inspectionSha256",
    "routePath",
    "routeSha256",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "animal-risk-evidence-manifest" },
    "animalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "inspectionPath": { "$ref": "#/$defs/absolutePath" },
    "inspectionSha256": { "$ref": "#/$defs/sha256" },
    "routePath": { "$ref": "#/$defs/absolutePath" },
    "routeSha256": { "$ref": "#/$defs/sha256" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifacts"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
